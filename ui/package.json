{
  "name": "cinemax-ui",
  "private": true,
  "version": "1.0.0",
  "description": "CINEMAX desktop frontend (React, embedded in the JUCE/WebView2 host as a single HTML file)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && vite build",
    "harness": "node dev/make-harness.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4"
  }
}
